# ============================================================
# KOBO CALIBRE BROWSER — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Chemin absolu vers le dossier de la bibliothèque Calibre sur l'hôte Unraid
# Adapter selon ton partage Unraid (le dossier doit contenir metadata.db)
CALIBRE_LIBRARY_PATH=/mnt/user/data/media/ebooks/calibre_library

# Domaine public de l'application (doit être géré par Traefik)
KOBO_DOMAIN=kobo.majurel.fr

# Réseau Docker externe de Traefik (nom exact tel que configuré sur Unraid)
TRAEFIK_NETWORK=docker_network

# Résolveur de certificat TLS configuré dans Traefik (cloudflare, letsencrypt…)
CERT_RESOLVER=cloudflare

# Middleware Authelia (authelia@file si configuration file-provider, authelia@docker sinon)
AUTHELIA_MIDDLEWARE=authelia@file

# Nombre de livres par page (défaut : 20)
ITEMS_PER_PAGE=20

# Niveau de log uvicorn : debug | info | warning | error
LOG_LEVEL=info

# ── Authentification in-app ──────────────────────────────────────────────────
# Mot de passe pour accéder à la bibliothèque (obligatoire)
APP_PASSWORD=changeme

# Clé secrète pour signer les cookies de session
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-with-a-random-64-char-hex-string
